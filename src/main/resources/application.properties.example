spring.application.name=pdd-bot-tg
spring.main.allow-circular-references=true
spring.messages.encoding=UTF-8
server.port=${SERVER_PORT:8081}

# ========== SQLite ==========
spring.datasource.url=${SQLITE_URL:jdbc:sqlite:bot_tokens.db}
spring.datasource.driver-class-name=org.sqlite.JDBC
spring.jpa.database-platform=org.hibernate.community.dialect.SQLiteDialect
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true

# ========== Admin ==========
bot.admin.id=${BOT_ADMIN_ID:7884795345}

# ========== Telegram ==========
telegram.bot.token=${TELEGRAM_BOT_TOKEN}
telegram.bot.username=${TELEGRAM_BOT_USERNAME:ai_pdd_bot}

# ========== Server ==========
myserver.address=${MYSERVER_ADDRESS:http://localhost:8080}

# ========== Messages ==========
bot.message.start=\u041F\u0440\u0438\u0432\u0435\u0442! \u042F AI \u0438\u043D\u0441\u0442\u0440\u0443\u043A\u0442\u043E\u0440 \u041F\u0414\u0414.\n\u042F \u043F\u043E\u043C\u043E\u0433\u0443 \u0442\u0435\u0431\u0435 \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u0438\u0442\u044C\u0441\u044F \u043A \u0442\u0435\u043E\u0440\u0435\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u043C\u0443 \u044D\u043A\u0437\u0430\u043C\u0435\u043D\u0443.\n\u0414\u0430\u0432\u0430\u0439 \u043D\u0430\u0447\u043D\u0451\u043C \u0441 \u0442\u0435\u0441\u0442\u043E\u0432\u043E\u0433\u043E \u0431\u0438\u043B\u0435\u0442\u0430 \u2014 \u043E\u043D \u043F\u043E\u043A\u0430\u0436\u0435\u0442 \u0442\u0432\u043E\u0438 \u0441\u0438\u043B\u044C\u043D\u044B\u0435 \u0438 \u0441\u043B\u0430\u0431\u044B\u0435 \u043C\u0435\u0441\u0442\u0430, \u0438 \u043D\u0430 \u043E\u0441\u043D\u043E\u0432\u0435 \u043E\u0448\u0438\u0431\u043E\u043A \u044F \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044E \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u043B\u044C\u043D\u0443\u044E \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0443 \u043E\u0431\u0443\u0447\u0435\u043D\u0438\u044F.\n\u041D\u0430\u0436\u043C\u0438 \u00AB\uD83C\uDFB2 \u0421\u043B\u0443\u0447\u0430\u0439\u043D\u044B\u0439 \u0431\u0438\u043B\u0435\u0442\u00BB \u0432 \u043D\u0438\u0436\u043D\u0435\u043C \u043C\u0435\u043D\u044E, \u0447\u0442\u043E\u0431\u044B \u043D\u0430\u0447\u0430\u0442\u044C.
bot.message.help=\u0414\u043B\u044F \u043D\u0430\u0447\u0430\u043B\u0430 \u043F\u0440\u043E\u0441\u0442\u043E \u0440\u0435\u0448\u0438 \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u044B\u0439 \u0431\u0438\u043B\u0435\u0442 \u2013 \u044D\u0442\u043E \u043F\u043E\u043C\u043E\u0436\u0435\u0442 \u0441\u043E\u0431\u0440\u0430\u0442\u044C \u0430\u043D\u0430\u043B\u0438\u0442\u0438\u043A\u0443 \u043F\u043E \u0442\u0432\u043E\u0438\u043C \u0437\u043D\u0430\u043D\u0438\u044F\u043C.\n\u041F\u043E\u0441\u043B\u0435 \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u0438\u044F \u0431\u0438\u043B\u0435\u0442\u0430 \u0441\u0442\u0430\u043D\u0435\u0442 \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u043E \u043F\u043E\u043B\u043D\u043E\u0435 \u043C\u0435\u043D\u044E \u0441\u043E \u0432\u0441\u0435\u043C\u0438 \u0444\u0443\u043D\u043A\u0446\u0438\u044F\u043C\u0438.\n\u0415\u0441\u043B\u0438 \u0437\u0430\u0445\u043E\u0447\u0435\u0448\u044C \u043D\u0430\u0447\u0430\u0442\u044C \u0437\u0430\u043D\u043E\u0432\u043E, \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439 \u043A\u043E\u043C\u0430\u043D\u0434\u0443 /start \u0438\u043B\u0438 \u043A\u043D\u043E\u043F\u043A\u0443 \u00AB\uD83C\uDFE0 \u041F\u0435\u0440\u0435\u0437\u0430\u043F\u0443\u0441\u043A\u00BB \u2013 \u0442\u0432\u043E\u044F \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043A\u0430 \u0438 \u043F\u043E\u0434\u043F\u0438\u0441\u043A\u0430 \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u0442\u0441\u044F.\u0423\u0434\u0430\u0447\u0438! \uD83D\uDE97

bot.message.responseRandomQuestion=\u041E\u043A
bot.message.responseRandomTicketErrorSession=\u0412\u0430\u0448\u0430 \u0441\u0435\u0441\u0441\u0438\u044F \u0438\u0441\u0442\u0435\u043A\u043B\u0430 \u0438\u043B\u0438 \u0431\u044B\u043B\u0430 \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u0430. \u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430, \u043D\u0430\u0436\u043C\u0438\u0442\u0435 \u0440\u0435\u0448\u0430\u0442\u044C \u0431\u0438\u043B\u0435\u0442 \u0441\u043D\u0430\u0447\u0430\u043B\u0430. \u0421\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043A\u0430 \u0438 \u043F\u043E\u0434\u043F\u0438\u0441\u043A\u0430 \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u0442\u0441\u044F.




