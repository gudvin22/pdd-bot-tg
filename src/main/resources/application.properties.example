spring.application.name=pdd-bot-tg
spring.main.allow-circular-references=true
spring.messages.encoding=UTF-8
server.port=${SERVER_PORT:8081}

# ========== SQLite ==========
spring.datasource.url=${SQLITE_URL:jdbc:sqlite:bot_tokens.db}
spring.datasource.driver-class-name=org.sqlite.JDBC
spring.jpa.database-platform=org.hibernate.community.dialect.SQLiteDialect
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true

# ========== Admin ==========
bot.admin.id=${BOT_ADMIN_ID}

# ========== Telegram ==========
telegram.bot.token=${TELEGRAM_BOT_TOKEN}
telegram.bot.username=${TELEGRAM_BOT_USERNAME}

# ========== Server ==========
myserver.address=${MYSERVER_ADDRESS:http://localhost:8080}

# ========== Messages ==========
bot.message.start=Привет! Я AI инструктор ПДД.\nЯ помогу тебе подготовиться к теоретическому экзамену.\nДавай начнём с тестового билета — он покажет твои сильные и слабые места, и на основе ошибок я составлю персональную программу обучения.\nНажми «🎲 Случайный билет» в нижнем меню, чтобы начать.
bot.message.help=Для начала просто реши случайный билет – это поможет собрать аналитику по твоим знаниям.\nПосле завершения билета станет доступно полное меню со всеми функциями.\nЕсли захочешь начать заново, используй команду /start или кнопку «🏠 Перезапуск» – твоя статистика и подписка сохранятся.Удачи! 🚗
bot.message.responseRandomQuestion=Ок
bot.message.responseRandomTicketErrorSession=Ваша сессия истекла или была потеряна. Пожалуйста, нажмите решать билет сначала. Статистика и подписка сохранятся.